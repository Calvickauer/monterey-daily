---
import { ViewTransitions } from 'astro:transitions';
import { B } from '../lib.js';
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import Fonts from '../components/Fonts.astro';
const { title = 'Monterey Daily', description = 'Monterey County news, gathered daily from local outlets.', heroImage = null } = Astro.props;
// Three wave layers. Each path repeats every 720 viewBox units (= one container
// width, since the SVG is 200% wide), so translateX(-50%) loops seamlessly.
const waves = {
  back:  'M0 22 Q90 6 180 22 T360 22 T540 22 T720 22 T900 22 T1080 22 T1260 22 T1440 22 V60 H0Z',
  mid:   'M0 32 Q180 52 360 32 T720 32 T1080 32 T1440 32 V60 H0Z',
  front: 'M0 40 Q180 18 360 40 T720 40 T1080 40 T1440 40 V60 H0Z',
};
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title}</title><meta name="description" content={description}/><meta name="theme-color" content="#0b2d4a"/><link rel="icon" href={`${B}/favicon.svg`}/>
{heroImage && <link rel="preload" as="image" href={heroImage} fetchpriority="high" referrerpolicy="no-referrer"/>}
<Fonts/>
<script is:inline>
 /* Opt in to scroll-reveal only when JS runs (cards stay visible without JS).
    Astro's router swaps <html> attributes on navigation, so re-add after each swap.
    Failsafe: if the reveal module never boots, drop .js so nothing stays hidden. */
 (function(d){var h=d.documentElement;h.classList.add('js');d.addEventListener('astro:after-swap',function(){h.classList.add('js')});
  setTimeout(function(){if(!window.__mdReveal)h.classList.remove('js')},4000)})(document);
</script>
<ViewTransitions/></head><body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="mast" transition:persist>
 <a class="brand" href={`${B}/`}>Monterey <em>Daily</em></a>
 <p class="tag">Monterey County news, gathered each morning</p>
 <div class="waves" aria-hidden="true">{Object.entries(waves).map(([k,d])=><svg class={`wave ${k}`} viewBox="0 0 1440 60" preserveAspectRatio="none"><path d={d}/></svg>)}</div>
</header>
<SiteNav/>
<main id="main" tabindex="-1"><slot/></main>
<footer><p>Monterey Daily links to and credits original reporting. Headlines and brief summaries only; read full stories at each outlet. Weather alerts: National Weather Service.</p></footer>
<script>
 const reduce = matchMedia('(prefers-reduced-motion: reduce)');
 const finePointer = matchMedia('(hover: hover) and (pointer: fine)');
 (window as any).__mdReveal = true;

 // Staggered scroll reveal: cards entering together get 70ms-step delays.
 let io: IntersectionObserver | undefined;
 function settle(el: HTMLElement){ el.classList.add('in','settled'); el.style.removeProperty('--d'); }
 function reveal(){
  io?.disconnect();
  const cards = [...document.querySelectorAll<HTMLElement>('.card:not(.in)')];
  if (reduce.matches || !('IntersectionObserver' in window)) { cards.forEach(settle); return; }
  io = new IntersectionObserver(entries=>{
   entries.filter(e=>e.isIntersecting)
    .sort((a,b)=>a.boundingClientRect.top-b.boundingClientRect.top || a.boundingClientRect.left-b.boundingClientRect.left)
    .forEach((e,i)=>{
     const el = e.target as HTMLElement; io!.unobserve(el);
     el.style.setProperty('--d', `${Math.min(i,8)*70}ms`);
     el.addEventListener('transitionend', ev=>{ if (ev.propertyName==='transform' && ev.target===el) settle(el); }, { once:false });
     requestAnimationFrame(()=>el.classList.add('in'));
     setTimeout(()=>settle(el), 1400 + Math.min(i,8)*70); // in case transitionend is skipped
    });
  }, { rootMargin:'0px 0px -6% 0px', threshold:0.06 });
  cards.forEach(c=>io!.observe(c));
 }

 // Subtle pointer tilt (max ~3deg), rAF-throttled, transform-only.
 let raf = 0, active: HTMLElement | null = null, px = 0, py = 0;
 function resetTilt(el: HTMLElement | null){ if (el) { el.style.removeProperty('--rx'); el.style.removeProperty('--ry'); } }
 document.addEventListener('pointermove', e=>{
  if (!finePointer.matches || reduce.matches || e.pointerType!=='mouse') return;
  const card = (e.target as Element).closest?.('.card.settled') as HTMLElement | null;
  if (card!==active) { resetTilt(active); active = card; }
  if (!card) return;
  px = e.clientX; py = e.clientY;
  if (!raf) raf = requestAnimationFrame(()=>{
   raf = 0; if (!active) return;
   const r = active.getBoundingClientRect();
   const x = (px-r.left)/r.width-.5, y = (py-r.top)/r.height-.5;
   active.style.setProperty('--ry', `${(x*6).toFixed(2)}deg`);
   active.style.setProperty('--rx', `${(-y*5).toFixed(2)}deg`);
  });
 }, { passive:true });
 document.addEventListener('pointerleave', ()=>{ resetTilt(active); active = null; });

 document.addEventListener('astro:page-load', ()=>{ reveal(); });
</script>
</body></html>
