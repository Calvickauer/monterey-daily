---
import { ViewTransitions } from 'astro:transitions';
import { CATS, B } from '../lib.js';
const { title = 'Monterey Daily', description = 'Monterey County news, gathered daily from local outlets.' } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title}</title><meta name="description" content={description}/><link rel="icon" href={`${B}/favicon.svg`}/>
<link rel="preconnect" href="https://fonts.googleapis.com"/><link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,800&family=Inter:wght@400;600&display=swap" rel="stylesheet"/>
<ViewTransitions/></head><body>
<header class="mast" transition:persist>
 <a class="brand" href={`${B}/`}>Monterey <em>Daily</em></a>
 <p class="tag">Monterey County news, gathered each morning</p>
 <nav><a href={`${B}/`}>Top</a>{Object.entries(CATS).map(([k,v])=><a href={`${B}/category/${k}/`}>{v}</a>)}<a href={`${B}/archive/`}>Archive</a><a href={`${B}/search/`}>Search</a></nav>
 <svg class="wave" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true"><path d="M0 30 Q180 0 360 30 T720 30 T1080 30 T1440 30 V60 H0Z"/><path class="w2" d="M0 40 Q180 15 360 40 T720 40 T1080 40 T1440 40 V60 H0Z"/></svg>
</header>
<main><slot/></main>
<footer><p>Monterey Daily links to and credits original reporting. Headlines and brief summaries only; read full stories at each outlet. Weather alerts: National Weather Service.</p></footer>
<script>
 function reveal(){ const els=document.querySelectorAll('.card:not(.in)');
  if(matchMedia('(prefers-reduced-motion: reduce)').matches||!('IntersectionObserver' in window)){els.forEach(e=>e.classList.add('in'));return;}
  const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}}),{rootMargin:'0px 0px -5% 0px'}); els.forEach(e=>io.observe(e)); }
 document.addEventListener('astro:page-load',reveal);
</script>
<style is:global>
:root{--ink:#0f2a3a;--sea:#1d6f8c;--kelp:#2f6b4f;--sand:#f6f1e7;--foam:#fffdf8;--coral:#d9644a;--muted:#5b6b73}
*{box-sizing:border-box}body{margin:0;overflow-x:clip;background:var(--sand);color:var(--ink);font:16px/1.55 Inter,system-ui,sans-serif}
a{color:var(--sea)}h1,h2,h3,.brand{font-family:Fraunces,Georgia,serif}
.mast{position:relative;overflow:hidden;background:linear-gradient(160deg,#0f2a3a,#1d6f8c);color:#fff;padding:1.2rem 1rem 3.2rem;text-align:center}
.brand{color:#fff;text-decoration:none;font-size:clamp(2rem,7vw,3.4rem);font-weight:800;letter-spacing:-.02em}.brand em{color:#9fd8e0}
.tag{margin:.2rem 0 .8rem;opacity:.85;font-size:.9rem}
nav{display:flex;gap:.3rem .9rem;flex-wrap:wrap;justify-content:center;font-size:.9rem}nav a{color:#e6f4f6;text-decoration:none}nav a:hover{text-decoration:underline}
.wave{position:absolute;bottom:-1px;left:0;width:200%;height:40px;fill:var(--sand);animation:drift 18s linear infinite}.wave .w2{opacity:.5}
@keyframes drift{to{transform:translateX(-50%)}}
main{max-width:1180px;margin:0 auto;padding:1rem}
h1.sec{font-size:1.7rem;border-bottom:3px solid var(--ink);padding-bottom:.3rem}
.grid{display:grid;gap:1.1rem;grid-template-columns:1fr}
@media(min-width:640px){.grid{grid-template-columns:repeat(2,1fr)}}@media(min-width:1000px){.grid{grid-template-columns:repeat(3,1fr)}.grid .lead{grid-column:span 2;grid-row:span 2}}
.card{background:var(--foam);border-radius:10px;overflow:hidden;box-shadow:0 1px 3px #0f2a3a22;display:flex;flex-direction:column;opacity:0;transform:translateY(18px);transition:opacity .6s ease,transform .6s ease,box-shadow .2s}
.card.in{opacity:1;transform:none}.card:hover{box-shadow:0 6px 18px #0f2a3a33}
.card figure{margin:0;position:relative;aspect-ratio:16/9;background:linear-gradient(135deg,#9fd8e0,#2f6b4f)}.card img{width:100%;height:100%;object-fit:cover;display:block}
.card figcaption{position:absolute;right:0;bottom:0;background:#0009;color:#fff;font-size:.68rem;padding:.1rem .4rem}
.card .body{padding:.9rem 1rem 1rem;display:flex;flex-direction:column;gap:.4rem;flex:1}
.card h3{margin:0;font-size:1.15rem;line-height:1.25}.lead h3{font-size:1.6rem}.card h3 a{color:var(--ink);text-decoration:none}.card h3 a:hover{color:var(--sea)}
.card p{margin:0;color:var(--muted);font-size:.93rem}.meta{margin-top:auto!important;font-size:.8rem!important;display:flex;flex-wrap:wrap;gap:.4rem;align-items:center}
.pill{background:var(--kelp);color:#fff;border-radius:99px;padding:.05rem .55rem;font-size:.72rem;text-decoration:none}
.src{font-weight:600;color:var(--ink)}
footer{text-align:center;color:var(--muted);font-size:.82rem;padding:2rem 1rem;max-width:760px;margin:0 auto}
.days a{display:inline-block;margin:.2rem .5rem .2rem 0}
@media (prefers-reduced-motion: reduce){*,*::before,*::after{animation:none!important;transition:none!important}.card{opacity:1;transform:none}::view-transition-group(*){animation:none!important}}
</style></body></html>
