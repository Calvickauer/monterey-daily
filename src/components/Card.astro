---
import { CATS, B, fmt, titleCollides, shortDate } from '../lib.js';
import { imgSrc, alsoCovered, imageKind, stockCredit } from '../media.js';
import ImageBadge from './ImageBadge.astro';
const { s, lead = false, eager = lead } = Astro.props;
const src = imgSrc(s.image);
// Image badge: "Illustration" for imageKind 'illustration' (or missing imageKind + imageGenerated);
// none for 'source' (alias 'photo') / 'stock'. Override with <Card kind="illustration"/>. [data-image-kind] is the styling hook.
const kind = src ? (Astro.props.kind ?? imageKind(s)) : null;
// Licensed stock photos always carry a credit caption: imageCredit linked to imageCreditUrl,
// enriched with per-part links when the optional imageAttribution is present.
const credit = src && s.imageKind === 'stock' ? stockCredit(s) : null;
// imageAlt (string | null): decorative alt="" when absent (or identical to the headline),
// since the headline sits right below the image on cards.
const rawAlt = typeof s.imageAlt === 'string' ? s.imageAlt.trim() : '';
const alt = rawAlt && rawAlt.toLowerCase() !== String(s.headline || '').trim().toLowerCase() ? rawAlt : '';
const also = alsoCovered(s);
// Same headline as another story (e.g. repeated evacuation updates): show the date with the headline.
const collide = titleCollides(s);
---
<article class:list={['card', `cat-${s.category}`, { lead, 'is-eager': eager }]}>
 <figure class:list={['card-media', { 'is-empty': !src }]} data-image-kind={kind ?? undefined}>
  {src && <img src={src} alt={alt} width="800" height="450"
     loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding={eager ? 'auto' : 'async'}
     referrerpolicy="no-referrer" class:list={[{ blurup: !eager }]}
     onload={eager ? undefined : "this.classList.add('is-loaded')"} onerror="this.closest('figure').classList.add('is-empty');this.remove()"/>}
  {kind && <ImageBadge kind={kind}/>}
  {credit && (
   <figcaption class="credit" data-pagefind-ignore>
    {credit.text ? (credit.url ? <a href={credit.url} target="_blank" rel="noopener">{credit.text}</a> : credit.text) : (<>
     {credit.filePhoto && 'File photo. '}Photo:{' '}
     {credit.author && (credit.authorUrl ? <a href={credit.authorUrl} target="_blank" rel="noopener">{credit.author}</a> : <span>{credit.author}</span>)}
     {credit.author && credit.source && ' / '}
     {credit.source && (credit.sourceUrl ? <a href={credit.sourceUrl} target="_blank" rel="noopener">{credit.source}</a> : <span>{credit.source}</span>)}
     {credit.license && <>, {credit.licenseUrl ? <a href={credit.licenseUrl} target="_blank" rel="license noopener">{credit.license}</a> : <span>{credit.license}</span>}</>}
     {credit.changeNote && <span title={credit.changes}>{` (${credit.changeNote})`}</span>}
    </>)}
   </figcaption>
  )}
  {/* Publisher photos ('source' / 'photo' / no imageKind) keep main's "Image: …" credit, linked when imageCreditUrl exists. */}
  {src && !kind && !credit && s.imageKind !== 'stock' && s.imageCredit && <figcaption data-pagefind-ignore>{/^https?:\/\//i.test(s.imageCreditUrl || '') ? <a href={s.imageCreditUrl} target="_blank" rel="noopener">{s.imageCredit}</a> : s.imageCredit}</figcaption>}
 </figure>
 <div class="body">
  <h3><a href={s.link} target="_blank" rel="noopener" data-pagefind-meta="url[href]">{s.headline}{collide && <span class="hl-date"> ({shortDate(s.date)})</span>}<span class="sr-only"> (opens in a new tab)</span></a></h3>
  <p>{s.summary}</p>
  {also.length > 0 && (
   <div class="also" data-pagefind-ignore>
    <span class="also-label" aria-hidden="true">Also covered by</span>
    <ul class="also-list" aria-label="Also covered by (links open in a new tab)">
     {also.map((a) => <li><a href={a.url} target="_blank" rel="noopener noreferrer" title={a.title} hreflang={a.es ? 'es' : undefined} lang={a.es ? 'es' : undefined}>{a.name}</a></li>)}
    </ul>
   </div>
  )}
  <p class="meta" data-pagefind-ignore><a class="chip" href={`${B}/category/${s.category}/`} data-pagefind-filter="category">{CATS[s.category]}</a>
   <span>Source: <a class="src" href={s.link} target="_blank" rel="noopener" title={`Read the full story at ${s.source}`} data-pagefind-filter="source">{s.source}</a></span><time datetime={s.date}>{fmt(s.date)}</time></p>
 </div></article>

<style>
 /* Frontend polish layer: image loading + "Also covered by". Palette, badge pill,
    reveal and hover motion live in src/styles/global.css (Stylist). */
 .card{--ui-accent:var(--c,var(--pacific-700));--ui-fade:.35s}
 /* Fixed 16:9 box (aspect-ratio + width/height attrs): no layout shift whether the
    image loads, fails, or is lazy. The figure's category-tinted gradient is the placeholder. */
 .card-media{aspect-ratio:16/9;contain:paint}
 .card-media img{width:100%;height:100%;object-fit:cover;display:block}
 /* Blur-up: the photo fades/un-blurs in over the placeholder once decoded. */
 /* Lead image: bias the crop toward the top so portrait subjects keep their heads. */
 .card.lead .card-media img{object-position:center 20%}
 .hl-date{font-weight:400;color:var(--muted);white-space:nowrap}
 img.blurup{opacity:0;filter:blur(14px);transform:scale(1.03);transition:opacity var(--ui-fade) ease,filter var(--ui-fade) ease,transform var(--ui-fade) ease}
 img.blurup.is-loaded{opacity:1;filter:none;transform:none}
 @media (prefers-reduced-motion: reduce){img.blurup{transition:none;filter:none;transform:none}}

 /* Stock-photo credit: full-width scrim pinned to the bottom of the 16:9 box (absolute, so no
    layout shift; the Illustration badge sits top-left and never appears on stock photos).
    on-dark text over pacific-950 at 82% stays >= 10:1 even over a pure-white photo. */
 .card figcaption.credit{left:0;right:0;bottom:0;max-width:none;padding:.3rem .6rem .35rem;border-radius:0;
   background:color-mix(in srgb,var(--pacific-950,#061a2b) 82%,transparent);color:var(--on-dark,#fff);
   font-size:.7rem;line-height:1.35;overflow-wrap:anywhere}
 .card figcaption:not(.credit) a{color:inherit;text-decoration:underline;text-underline-offset:.14em}
 .card figcaption:not(.credit) a:focus-visible{outline:2px solid var(--gold-400);outline-offset:1px}
 .credit a{color:inherit;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:.14em}
 .credit a:hover{color:var(--gold-200)}
 .credit a:focus-visible{outline:2px solid var(--gold-400);outline-offset:1px;border-radius:2px}

 .also{display:flex;flex-wrap:wrap;align-items:baseline;gap:.15rem .5rem;font-size:.8rem;color:var(--muted)}
 .also-label{font-weight:600}
 .also-list{display:flex;flex-wrap:wrap;gap:.15rem .5rem;list-style:none;margin:0;padding:0}
 .also-list li:not(:last-child)::after{content:"·";margin-left:.5rem;color:var(--muted)}
 .also-list a{color:var(--ui-accent);font-weight:600;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:.15em}
 .also-list a:hover{text-decoration-thickness:2px}
</style>
