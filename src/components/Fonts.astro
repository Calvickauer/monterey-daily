---
// Self-hosted fonts (replaces the render-blocking Google Fonts stylesheet).
// Same families/weights as before; font stacks live in --font-serif / --font-sans.
import { B } from '../lib.js';
const latin = 'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD';
const serif = `${B}/fonts/fraunces-latin-wght600-800.woff2`;
const sans = `${B}/fonts/inter-latin-wght400-600.woff2`;
const css = `@font-face{font-family:'Fraunces';font-style:normal;font-weight:600 800;font-display:swap;src:url(${serif}) format('woff2');unicode-range:${latin}}
@font-face{font-family:'Inter';font-style:normal;font-weight:400 600;font-display:swap;src:url(${sans}) format('woff2');unicode-range:${latin}}
:root{--font-serif:Fraunces,Georgia,serif;--font-sans:Inter,system-ui,sans-serif}`;
---
<link rel="preload" href={sans} as="font" type="font/woff2" crossorigin/>
<link rel="preload" href={serif} as="font" type="font/woff2" crossorigin/>
<style is:inline set:html={css}></style>
