---
// Frosted "AI illustration" pill. Place inside a positioned image wrapper that
// carries data-ai-generated (see README > AI illustration badge).
const { label = 'AI illustration' } = Astro.props;
---
<span class="ai-badge" role="note" aria-label={`${label}: this image was generated with AI`} data-pagefind-ignore><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 0l1.6 4.8L14.4 6.4 9.6 8 8 12.8 6.4 8 1.6 6.4 6.4 4.8zM13 10.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z"/></svg><span aria-hidden="true">{label}</span></span>
