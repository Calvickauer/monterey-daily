---
// Frosted image-kind pill (Stylist's style). Place inside a positioned image wrapper
// that carries data-image-kind (see README > Image badges).
//   kind="ai"           photo-realistic AI-generated image   -> "AI-generated image"
//   kind="illustration" per-category illustration library    -> "Illustration"
const { kind = 'illustration' } = Astro.props;
const K = {
  ai: { label: 'AI-generated image', desc: 'AI-generated image: not a real photo of this story',
        icon: 'M8 0l1.6 4.8L14.4 6.4 9.6 8 8 12.8 6.4 8 1.6 6.4 6.4 4.8zM13 10.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z' },
  illustration: { label: 'Illustration', desc: 'Illustration: not a photo of this story',
        icon: 'M11.6 1.2a1.2 1.2 0 0 1 1.7 0l1.5 1.5a1.2 1.2 0 0 1 0 1.7L5.6 13.6l-3.9 1.1 1.1-3.9z' },
};
const k = K[kind] ?? K.illustration;
---
<span class="img-badge" data-kind={kind} role="note" aria-label={k.desc} title={k.desc} data-pagefind-ignore><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d={k.icon}/></svg><span aria-hidden="true">{k.label}</span></span>
