---
import Base from '../../layouts/Base.astro'; import Card from '../../components/Card.astro'; import SectionHeader from '../../components/SectionHeader.astro'; import { stories, CATS } from '../../lib.js'; import { imgSrc } from '../../media.js';
export function getStaticPaths(){ return Object.keys(CATS).map(cat=>({params:{cat}})); }
const { cat } = Astro.params; const list = stories.filter(s=>s.category===cat).slice(0,60);
---
<Base title={`${CATS[cat]} – Monterey Daily`} heroImage={list[0]?.image ? imgSrc(list[0].image) : null}><SectionHeader title={CATS[cat]} kicker="Category" sub={list.length ? `${list.length} recent ${list.length===1?'story':'stories'}` : undefined} cat={cat}/>{list.length?<><h2 class="sr-only">Latest {CATS[cat]} stories</h2><div class="grid">{list.map((s,i)=><Card s={s} eager={i===0}/>)}</div></>:<p>No stories yet.</p>}</Base>
