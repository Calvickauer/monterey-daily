---
import Base from '../../layouts/Base.astro'; import Card from '../../components/Card.astro'; import { stories, day } from '../../lib.js';
export function getStaticPaths(){ return [...new Set(stories.map(s=>day(s.date)))].map(date=>({params:{date}})); }
const { date } = Astro.params; const list = stories.filter(s=>day(s.date)===date);
---
<Base title={`${date} – Monterey Daily`}><h1 class="sec">{new Date(date+'T12:00').toLocaleDateString('en-US',{weekday:'long',month:'long',day:'numeric',year:'numeric'})}</h1><div class="grid">{list.map(s=><Card s={s}/>)}</div></Base>
